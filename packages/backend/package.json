{
  "name": "@zevauth/backend",
  "version": "0.2.1",
  "description": "ZevAuth for your server. Manage users and organizations with a secret key.",
  "keywords": [
    "zevauth",
    "authentication",
    "auth",
    "admin",
    "server",
    "backend"
  ],
  "license": "MIT",
  "author": "ZevOp Inc.",
  "homepage": "https://docs.zevauth.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zevop/zevauth-sdk.git",
    "directory": "packages/backend"
  },
  "bugs": {
    "url": "https://github.com/zevop/zevauth-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./verify": {
      "types": "./dist/verify.d.ts",
      "import": "./dist/verify.js"
    },
    "./bridge": {
      "types": "./dist/bridge.d.ts",
      "import": "./dist/bridge.js"
    },
    "./webhooks": {
      "types": "./dist/webhooks.d.ts",
      "import": "./dist/webhooks.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/write-version.mjs && tsc -b",
    "typecheck": "tsc -b",
    "verify": "tsx scripts/verify.ts && tsx scripts/conformance.ts"
  },
  "dependencies": {
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "typescript": "~5.9.0"
  }
}
