{
  "name": "@zevauth/nextjs",
  "version": "0.1.3",
  "description": "ZevAuth for Next.js: middleware, server helpers and components.",
  "keywords": [
    "zevauth",
    "authentication",
    "auth",
    "nextjs",
    "next",
    "middleware",
    "sso"
  ],
  "license": "MIT",
  "author": "ZevOp",
  "homepage": "https://docs.zevauth.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zevop/zevauth-sdk.git",
    "directory": "packages/nextjs"
  },
  "bugs": {
    "url": "https://github.com/zevop/zevauth-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "verify": "tsx scripts/verify.ts"
  },
  "peerDependencies": {
    "next": ">=14",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@zevauth/js": "^0.1.3",
    "@zevauth/react": "^0.1.3",
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "react": "^19.2.4",
    "tsx": "^4.20.6",
    "typescript": "~5.9.0"
  }
}
