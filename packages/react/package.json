{
  "name": "@zevauth/react",
  "version": "0.2.6",
  "description": "ZevAuth for React: hooks and drop-in authentication components.",
  "keywords": [
    "zevauth",
    "authentication",
    "auth",
    "react",
    "hooks",
    "components",
    "sso"
  ],
  "license": "MIT",
  "author": "ZevOp",
  "homepage": "https://docs.zevauth.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zevop/zevauth-sdk.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/zevop/zevauth-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "verify": "tsx scripts/verify.tsx"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@zevauth/js": "^0.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsx": "^4.20.6",
    "typescript": "~5.9.0"
  }
}
